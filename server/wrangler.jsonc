{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaza-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // Placeholder on a reserved domain (RFC 2606): it can never reach anyone.
  // Replace with the real project address before release.
  // GOOGLE_CLIENT_ID: the Web OAuth client id Google ID tokens must be for.
  "vars": { "PRIVACY_CONTACT": "privacy@beaza.example", "GOOGLE_CLIENT_ID": "16049310186-eb57dja4q527kmotnt4krj40anri2331.apps.googleusercontent.com" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beaza-sync-eu",
      "database_id": "9b1a471b-46ee-4758-b808-fbdda4036dd0",
      "migrations_dir": "migrations"
    }
  ]
}
