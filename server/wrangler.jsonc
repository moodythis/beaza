{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaza-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beaza-sync-eu",
      "database_id": "9b1a471b-46ee-4758-b808-fbdda4036dd0",
      "migrations_dir": "migrations"
    }
  ]
}
